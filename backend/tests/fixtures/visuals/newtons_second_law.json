        "expression": ""
      },
      {
        "id": "s4",
        "type": "recap",
        "heading": "Remember",
        "narration": "",
        "steps": [
          {
            "text": "Bigger force → bigger acceleration",
            "narration": "For the same mass, a bigger force gives a bigger acceleration.",
            "note": "",
            "lines": [],
            "output": "",
            "in_expression": true
          },
          {
            "text": "Bigger mass → smaller acceleration",
            "narration": "For the same force, a heavier object speeds up more slowly.",
            "note": "",
            "lines": [],
            "output": "",
            "in_expression": true
          },
          {
            "text": "F = m × a",
            "narration": "In short, force equals mass times acceleration.",
