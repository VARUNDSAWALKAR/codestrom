  "scenes": [
    {
      "scene_id": "s1",
      "type": "title_card",
      "start_frame": 0,
      "duration_frames": 206,
      "beats": [
        {
          "beat_id": "s1.intro",
          "step_index": null,
          "start_frame": 9,
          "end_frame": 189,
          "captions": [
            {
              "text": "Newton's second law tells us how a force changes the motion of an object.",
              "start_frame": 9,
              "end_frame": 189
            }
          ]
        }
      ]
    },
    {
      "scene_id": "s2",
      "type": "formula",
      "start_frame": 206,
      "duration_frames": 593,
      "beats": [
        {
          "beat_id": "s2.intro",
          "step_index": null,
          "start_frame": 216,
          "end_frame": 332,
          "captions": [
            {
              "text": "The law says that force equals mass times acceleration.",
              "start_frame": 216,
              "end_frame": 332
            }
          ]
        },
        {
          "beat_id": "s2.step0",
          "step_index": 0,
          "start_frame": 340,
          "end_frame": 494,
          "captions": [
            {
              "text": "F stands for the net force on the object, measured in newtons.",
              "start_frame": 340,
              "end_frame": 494
            }
          ]
        },
        {
          "beat_id": "s2.step1",
          "step_index": 1,
          "start_frame": 502,
          "end_frame": 594,
          "captions": [
            {
              "text": "m stands for mass, measured in kilograms.",
              "start_frame": 502,
              "end_frame": 594
            }
          ]
        },
        {
          "beat_id": "s2.step2",
          "step_index": 2,
          "start_frame": 602,
          "end_frame": 781,
          "captions": [
            {
              "text": "The last symbol stands for acceleration, which tells us how fast the velocity changes.",
              "start_frame": 602,
              "end_frame": 781
            }
          ]
        }
      ]
    },
    {
      "scene_id": "s3",
      "type": "diagram",
      "start_frame": 799,
      "duration_frames": 543,
      "beats": [
        {
          "beat_id": "s3.intro",
          "step_index": null,
          "start_frame": 808,
          "end_frame": 875,
          "captions": [
            {
              "text": "Let's try it with numbers.",
              "start_frame": 808,
              "end_frame": 875
            }
          ]
        },
        {
          "beat_id": "s3.step0",
          "step_index": 0,
          "start_frame": 883,
          "end_frame": 987,
          "captions": [
            {
              "text": "A cart has a mass of two kilograms.",
              "start_frame": 883,
              "end_frame": 987
            }
          ]
        },
        {
          "beat_id": "s3.step1",
          "step_index": 1,
          "start_frame": 995,
          "end_frame": 1124,
          "captions": [
            {
              "text": "You push it with a net force of ten newtons.",
              "start_frame": 995,
              "end_frame": 1124
            }
          ]
        },
        {
          "beat_id": "s3.step2",
          "step_index": 2,
          "start_frame": 1132,
          "end_frame": 1324,
          "captions": [
            {
              "text": "So the acceleration is ten divided by two, which is five metres per second squared.",
              "start_frame": 1132,
              "end_frame": 1324
            }
          ]
        }
      ]
    },
    {
      "scene_id": "s4",
      "type": "recap",
      "start_frame": 1342,
      "duration_frames": 418,
      "beats": [
        {
          "beat_id": "s4.step0",
          "step_index": 0,
          "start_frame": 1351,
          "end_frame": 1493,
          "captions": [
            {
              "text": "For the same mass, a bigger force gives a bigger acceleration.",
              "start_frame": 1351,
              "end_frame": 1493
            }
          ]
        },
        {
          "beat_id": "s4.step1",
          "step_index": 1,
          "start_frame": 1500,
          "end_frame": 1642,
          "captions": [
            {
              "text": "For the same force, a heavier object speeds up more slowly.",
              "start_frame": 1500,
              "end_frame": 1642
            }
          ]
        },
        {
          "beat_id": "s4.step2",
          "step_index": 2,
          "start_frame": 1650,
          "end_frame": 1742,
          "captions": [
            {
              "text": "In short, force equals mass times acceleration.",
              "start_frame": 1650,
              "end_frame": 1742
            }
          ]
        }
      ]
    }
  ]
}
