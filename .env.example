# Local configuration template. Copy to .env and adjust paths for your machine.
# Never commit .env, model weights or generated outputs.
MODELS_DIR=C:/Users/ROG/Kavach/models
KOKORO_MODEL=kokoro/kokoro-v1.0.onnx
KOKORO_VOICES=kokoro/voices-v1.0.bin
KOKORO_VOICE_FEMALE=hf_alpha
KOKORO_VOICE_MALE=hm_omega
KOKORO_ENGLISH_LANG=en-us
DEVICE=auto
LOW_RAM=0
